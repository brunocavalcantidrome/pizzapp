<%- include('../partials/head', { title: restaurant.name + ' - Cardápio' }) %>
<style>
  .menu-wrap { max-width: 720px; margin: 0 auto; padding-bottom: 96px; }
  .menu-cover { height: 150px; background: linear-gradient(135deg, #7a0e14, #EA1D2C 60%, #FF6D00);
    background-size: cover; background-position: center; }
  .menu-store { background: #fff; border-bottom: 1px solid #E0E0E0; padding: 0 16px 14px;
    position: relative; z-index: 1; }
  .menu-store-row { display: flex; gap: 12px; align-items: flex-end; margin-top: -28px; }
  .menu-logo { width: 72px; height: 72px; border-radius: 16px; background: #fff; border: 3px solid #fff;
    display: flex; align-items: center; justify-content: center; font-size: 38px; overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,.15); }
  .menu-logo img { width: 100%; height: 100%; object-fit: cover; }
  .menu-store h1 { font-size: 1.25em; }
  .menu-store .city { color: #5F6368; font-size: .85em; }
  .menu-badges { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; font-size: .8em; }
  .menu-badge { border: 1px solid #E0E0E0; border-radius: 999px; padding: 4px 10px; background: #fff; }
  .menu-badge.open { color: #10B981; border-color: #10B981; font-weight: 700; }
  .menu-search { padding: 12px 16px 0; position: sticky; top: 0; background: #F8F9FA; z-index: 5; }
  .menu-search input { width: 100%; padding: 11px 14px; border-radius: 12px; border: 1px solid #E0E0E0; font-size: 1em; }
  .category-nav { overflow-x: auto; padding: 10px 16px; }
  .category-nav-list { display: flex; gap: 8px; list-style: none; }
  .category-nav-link { white-space: nowrap; border: 1px solid #E0E0E0; background: #fff; color: #111827;
    border-radius: 999px; padding: 8px 14px; font-size: .9em; cursor: pointer; }
  .category-nav-link small { color: #5F6368; }
  .category-nav-link.is-active { background: #111827; color: #fff; border-color: #111827; }
  .category-nav-link.is-active small { color: #ddd; }
  .category-title { padding: 14px 16px 8px; font-size: 1.1em; }
  .products-grid { display: flex; flex-direction: column; gap: 10px; padding: 0 16px; }
  .regular-product-card { background: #fff; border: 1px solid #E0E0E0; border-radius: 14px;
    padding: 12px; position: relative; cursor: pointer; }
  .regular-product-layout { display: flex; gap: 12px; }
  .product-image-container { width: 86px; height: 86px; flex-shrink: 0; }
  .regular-product-image { width: 100%; height: 100%; border-radius: 10px; background: #f1f1f1;
    display: flex; align-items: center; justify-content: center; font-size: 34px; overflow: hidden; }
  .regular-product-image img { width: 100%; height: 100%; object-fit: cover; }
  .regular-product-content { flex: 1; min-width: 0; }
  .regular-product-name { font-weight: 700; }
  .tag-build { font-size: .68em; background: #fff3e0; color: #c25700; border-radius: 6px; padding: 2px 6px; margin-left: 6px; }
  .regular-product-description { color: #5F6368; font-size: .85em; margin-top: 3px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .regular-product-price { margin-top: 6px; font-weight: 700; }
  .unavailable { font-size: .72em; color: #EA1D2C; font-weight: 700; }
  .product-add-cta { position: absolute; right: 12px; bottom: 12px; width: 32px; height: 32px;
    border-radius: 50%; background: #EA1D2C; color: #fff; display: flex;
    align-items: center; justify-content: center; font-size: 20px; line-height: 1; }
  .regular-product-card.is-off { opacity: .65; cursor: default; }
  .menu-cart-aside { padding: 0 16px; margin-top: 16px; }
</style>

<div class="menu-wrap">

  <div class="menu-cover" <% if (restaurant.cover_url) { %>style="background-image:url('<%= restaurant.cover_url %>')"<% } %>></div>
  <div class="menu-store">
    <div class="menu-store-row">
      <div class="menu-logo"><% if (restaurant.logo_url) { %><img src="<%= restaurant.logo_url %>" alt="Logo"><% } else { %>🍕<% } %></div>
      <div>
        <h1><%= restaurant.name %></h1>
        <div class="city">📱 <%= restaurant.whatsapp %></div>
      </div>
    </div>
    <div class="menu-badges">
      <span class="menu-badge open">● Aberto agora</span>
    </div>
  </div>

  <div class="menu-search">
    <input id="menu-search" type="text" placeholder="Buscar no cardápio..." oninput="onMenuSearch()">
  </div>

  <nav class="category-nav">
    <ul class="category-nav-list" id="menu-chips"></ul>
  </nav>

  <div id="menu-sections"></div>

  <div class="menu-cart-aside">
    <div class="card">
      <h2>Seu Pedido</h2>
      <div id="cart-items">
        <p class="empty" id="cart-empty">Carrinho vazio</p>
      </div>
      <div class="cart-total">
        <span>Total</span>
        <span id="cart-total">R$ 0.00</span>
      </div>
    </div>

    <div class="card" id="checkout-card" style="display:none;">
      <h2>Finalizar Pedido</h2>
      <form id="checkout-form">
        <label>Nome</label>
        <input type="text" id="customer_name" required>

        <label>Telefone (WhatsApp)</label>
        <input type="tel" id="customer_phone" placeholder="(71) 98730-1606" inputmode="tel" autocomplete="tel" required>

        <label>Endereço de entrega</label>
        <textarea id="delivery_address" rows="2" required></textarea>

        <label>Forma de pagamento</label>
        <select id="payment_method">
          <option value="dinheiro">Dinheiro</option>
          <option value="cartao">Cartão</option>
          <option value="pix">Pix</option>
        </select>

        <div id="order-error" class="msg-error"></div>
        <button type="submit" style="width:100%;">Confirmar Pedido</button>
      </form>
    </div>

    <div class="card" id="success-card" style="display:none;">
      <h2>Pedido realizado! 🎉</h2>
      <p id="success-message" class="msg-success"></p>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- Modal Montar -->
<div class="builder-overlay" id="builder-overlay" style="display:none;">
  <div class="builder-modal">
    <div class="builder-header">
      <h2 id="builder-title">Montar</h2>
      <button class="small secondary" onclick="closeBuilder()">Fechar</button>
    </div>
    <p class="builder-base" id="builder-base"></p>
    <div id="builder-groups"></div>
    <div class="builder-footer">
      <span id="builder-total">R$ 0.00</span>
      <button id="builder-confirm" onclick="confirmBuilder()" disabled>Adicionar ao pedido</button>
    </div>
    <div id="builder-error" class="msg-error"></div>
  </div>
</div>

<script>
  const SLUG = '<%= restaurant.slug %>';
  const CATEGORIES = <%- JSON.stringify(categories).replace(/</g, '\\u003c') %>;
  const PRODUCTS = <%- JSON.stringify(products).replace(/</g, '\\u003c') %>;
  const cart = new Map();
  let menuCat = null, menuQuery = '';

  function fmt(v) { return 'R$ ' + Number(v).toFixed(2); }
  function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 1800);
  }

  // ---- Cardápio por categorias (estilo referência) ----
  function onMenuSearch() {
    menuQuery = document.getElementById('menu-search').value.toLowerCase();
    renderMenu();
  }

  function selMenuCat(id) {
    menuCat = (id === null || id === undefined) ? null : Number(id);
    renderMenu();
  }

  function productImage(p) {
    if (p.image_url) return `<img src="${esc(p.image_url)}" alt="" loading="lazy">`;
    return '🍽';
  }

  function productCard(p) {
    const off = !Number(p.is_available);
    const price = Number(p.is_customizable) ? `a partir de ${fmt(p.price)}` : fmt(p.price);
    const action = off
      ? ''
      : (Number(p.is_customizable) ? `openBuilder(${p.id})` : `addToCart(${p.id}, '${esc(p.name).replace(/'/g, "\\'")}', ${Number(p.price)})`);
    return `<div class="regular-product-card ${off ? 'is-off' : ''}" ${action ? `onclick="${action}"` : ''}>
      <div class="regular-product-layout">
        <div class="product-image-container"><div class="regular-product-image">${productImage(p)}</div></div>
        <div class="regular-product-content">
          <div class="regular-product-name">${esc(p.name)}${Number(p.is_customizable) ? '<span class="tag-build">Monte o seu</span>' : ''}</div>
          ${p.description ? `<div class="regular-product-description">${esc(p.description)}</div>` : ''}
          <div class="regular-product-price">${off ? '<span class="unavailable">Indisponível</span> · ' : ''}${price}</div>
        </div>
      </div>
      ${off ? '' : '<span class="product-add-cta">+</span>'}
    </div>`;
  }

  function renderMenu() {
    const chips = document.getElementById('menu-chips');
    const box = document.getElementById('menu-sections');
    const q = menuQuery;

    const matchQ = (p) => ((p.name || '') + ' ' + (p.description || '')).toLowerCase().includes(q);

    const total = PRODUCTS.filter(matchQ).length;
    let h = `<li><button class="category-nav-link ${menuCat === null ? 'is-active' : ''}" onclick="selMenuCat(null)">Cardápio completo <small>${total}</small></button></li>`;
    CATEGORIES.forEach(c => {
      const n = PRODUCTS.filter(p => Number(p.category_id) === Number(c.id) && matchQ(p)).length;
      h += `<li><button class="category-nav-link ${menuCat === Number(c.id) ? 'is-active' : ''}" onclick="selMenuCat(${c.id})">${esc(c.name)} <small>${n}</small></button></li>`;
    });
    chips.innerHTML = h;

    box.innerHTML = '';
    const groups = [...CATEGORIES.map(c => ({ id: Number(c.id), name: c.name }))];
    if (PRODUCTS.some(p => !p.category_id && matchQ(p))) groups.push({ id: null, name: 'Outros' });

    groups.forEach(g => {
      if (menuCat !== null && g.id !== menuCat) return;
      const items = PRODUCTS.filter(p =>
        (g.id === null ? !p.category_id : Number(p.category_id) === g.id) && matchQ(p)
      );
      if (!items.length) return;
      box.innerHTML += `<h2 class="category-title">${esc(g.name)}</h2><div class="products-grid">` +
        items.map(productCard).join('') + `</div>`;
    });

    if (!box.innerHTML) box.innerHTML = '<p class="empty" style="padding:16px;">Nenhum resultado. Tente outras palavras.</p>';
  }

  function cartKey(id, optionIds) {
    const sorted = [...(optionIds || [])].map(Number).sort((a, b) => a - b);
    return id + '::' + sorted.join(',');
  }

  function addToCart(id, name, price) {
    const key = cartKey(id, []);
    const item = cart.get(key) || { key, id, name, price: Number(price), quantity: 0, option_ids: [], option_labels: [] };
    item.quantity += 1;
    cart.set(key, item);
    renderCart();
    showToast(name + ' adicionado');
  }

  function removeFromCart(key) {
    cart.delete(key);
    renderCart();
  }

  function changeQty(key, delta) {
    const item = cart.get(key);
    if (!item) return;
    item.quantity += delta;
    if (item.quantity <= 0) cart.delete(key);
    renderCart();
  }

  function renderCart() {
    const container = document.getElementById('cart-items');
    const emptyMsg = document.getElementById('cart-empty');
    const checkoutCard = document.getElementById('checkout-card');
    container.innerHTML = '';

    if (cart.size === 0) {
      container.appendChild(emptyMsg);
      checkoutCard.style.display = 'none';
    } else {
      checkoutCard.style.display = 'block';
      cart.forEach(item => {
        const div = document.createElement('div');
        div.className = 'cart-item-builder';
        const opts = (item.option_labels && item.option_labels.length)
          ? `<br><small>${esc(item.option_labels.join(', '))}</small>`
          : '';
        div.innerHTML =
          `<div><strong>${item.quantity}x ${esc(item.name)}</strong>${opts}<br><small>${fmt(item.price)} un.</small></div>` +
          `<div style="white-space:nowrap;">${fmt(item.price * item.quantity)} ` +
          `<button class="small secondary" data-k="${esc(item.key)}" onclick="changeQty(decodeURIComponent('${encodeURIComponent(item.key)}'), -1)">-</button> ` +
          `<button class="small secondary" data-k="${esc(item.key)}" onclick="changeQty(decodeURIComponent('${encodeURIComponent(item.key)}'), 1)">+</button> ` +
          `<button class="small danger" onclick="removeFromCart(decodeURIComponent('${encodeURIComponent(item.key)}'))">x</button></div>`;
        container.appendChild(div);
      });
    }

    const total = Array.from(cart.values()).reduce((sum, i) => sum + i.price * i.quantity, 0);
    document.getElementById('cart-total').textContent = fmt(total);
  }

  // ---- Builder ----
  let builderState = null;

  async function openBuilder(productId) {
    document.getElementById('builder-overlay').style.display = 'flex';
    document.getElementById('builder-groups').innerHTML = '<p class="empty">Carregando opções...</p>';
    document.getElementById('builder-error').textContent = '';
    try {
      const res = await fetch(`/api/builder/${SLUG}/${productId}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Erro ao carregar');
      builderState = {
        product: data.product,
        groups: data.groups || [],
        selected: new Map()
      };
      document.getElementById('builder-title').textContent = 'Montar: ' + data.product.name;
      document.getElementById('builder-base').textContent =
        'Base ' + fmt(data.product.price) + ' + adicionais por opção';
      renderBuilder();
    } catch (err) {
      document.getElementById('builder-groups').innerHTML = '';
      document.getElementById('builder-error').textContent = err.message;
    }
  }

  function closeBuilder() {
    document.getElementById('builder-overlay').style.display = 'none';
    builderState = null;
  }

  function renderBuilder() {
    const box = document.getElementById('builder-groups');
    box.innerHTML = '';
    if (!builderState.groups.length) {
      box.innerHTML = '<p class="empty">Nenhuma opção cadastrada ainda.</p>';
      return;
    }
    builderState.groups.forEach(g => {
      const sel = builderState.selected.get(g.id) || new Set();
      const isSingle = Number(g.max_allowed) === 1;
      const gdiv = document.createElement('div');
      gdiv.className = 'builder-group';
      gdiv.innerHTML =
        `<h3>${esc(g.name)} <small>(${sel.size}/${g.max_allowed}${g.min_required > 0 ? ', mín ' + g.min_required : ''})</small></h3>` +
        (g.description ? `<p class="builder-desc">${esc(g.description)}</p>` : '') +
        g.options.map(o => {
          const checked = sel.has(o.id) ? 'checked' : '';
          const extra = Number(o.extra_price) > 0 ? ' +' + fmt(o.extra_price) : ' incluso';
          return `<label class="builder-option"><input type="${isSingle ? 'radio' : 'checkbox'}" name="g_${g.id}" ${checked} onchange="toggleOption(${g.id}, ${o.id})"> ${esc(o.name)}<span>${extra}</span></label>`;
        }).join('');
      box.appendChild(gdiv);
    });
    updateBuilderTotal();
  }

  function toggleOption(groupId, optionId) {
    const g = builderState.groups.find(x => x.id === groupId);
    if (!g) return;
    let sel = builderState.selected.get(groupId) || new Set();
    if (Number(g.max_allowed) === 1) {
      sel = new Set([optionId]);
    } else {
      if (sel.has(optionId)) {
        sel.delete(optionId);
      } else {
        if (sel.size >= Number(g.max_allowed)) {
          showToast(`Máximo ${g.max_allowed} em ${g.name}`);
          renderBuilder();
          return;
        }
        sel.add(optionId);
      }
    }
    builderState.selected.set(groupId, sel);
    renderBuilder();
  }

  function builderSelection() {
    const optionIds = [];
    const labels = [];
    let extras = 0;
    builderState.groups.forEach(g => {
      const sel = builderState.selected.get(g.id) || new Set();
      sel.forEach(oid => {
        const opt = g.options.find(o => o.id === oid);
        if (opt) {
          optionIds.push(opt.id);
          labels.push(opt.name);
          extras += Number(opt.extra_price);
        }
      });
    });
    return { optionIds, labels, extras };
  }

  function updateBuilderTotal() {
    const { extras } = builderSelection();
    const total = Number(builderState.product.price) + extras;
    document.getElementById('builder-total').textContent = fmt(total);
    let ok = true;
    let missing = '';
    builderState.groups.forEach(g => {
      const sel = builderState.selected.get(g.id) || new Set();
      if (sel.size < Number(g.min_required) || sel.size > Number(g.max_allowed)) {
        ok = false;
        if (sel.size < Number(g.min_required)) missing = `"${g.name}": escolha pelo menos ${g.min_required}`;
      }
    });
    document.getElementById('builder-confirm').disabled = !ok;
    document.getElementById('builder-error').textContent = ok ? '' : missing;
  }

  function confirmBuilder() {
    if (!builderState) return;
    const { optionIds, labels, extras } = builderSelection();
    const unit = Number(builderState.product.price) + extras;
    const key = cartKey(builderState.product.id, optionIds);
    const item = cart.get(key) || {
      key, id: builderState.product.id, name: builderState.product.name,
      price: unit, quantity: 0, option_ids: optionIds, option_labels: labels
    };
    item.quantity += 1;
    item.price = unit;
    item.option_ids = optionIds;
    item.option_labels = labels;
    cart.set(key, item);
    closeBuilder();
    renderCart();
    showToast(builderState ? 'Montado adicionado' : 'Adicionado');
  }

  document.getElementById('builder-overlay').addEventListener('click', (e) => {
    if (e.target.id === 'builder-overlay') closeBuilder();
  });

  // ---- Máscara de telefone BR ----
  function maskPhone(value) {
    let d = value.replace(/\D/g, '');
    if (d.length > 11 && d.startsWith('55')) d = d.slice(2);
    d = d.slice(0, 11);
    if (!d.length) return '';
    if (d.length <= 2) return `(${d}`;
    if (d.length <= 6) return `(${d.slice(0, 2)}) ${d.slice(2)}`;
    if (d.length <= 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
    return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
  }

  function validPhone(value) {
    const d = value.replace(/\D/g, '');
    return d.length === 10 || d.length === 11;
  }

  document.getElementById('customer_phone').addEventListener('input', (e) => {
    e.target.value = maskPhone(e.target.value);
  });

  document.getElementById('checkout-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errorEl = document.getElementById('order-error');
    errorEl.textContent = '';

    const phoneVal = document.getElementById('customer_phone').value;
    if (!validPhone(phoneVal)) {
      errorEl.textContent = 'Informe um telefone válido com DDD, ex: (71) 98730-1606.';
      return;
    }

    const payload = {
      customer_name: document.getElementById('customer_name').value,
      customer_phone: phoneVal,
      delivery_address: document.getElementById('delivery_address').value,
      payment_method: document.getElementById('payment_method').value,
      items: Array.from(cart.values()).map(i => ({ product_id: i.id, quantity: i.quantity, option_ids: i.option_ids || [] }))
    };

    try {
      const res = await fetch(`/api/orders/${SLUG}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data.error || 'Erro ao enviar pedido.';
        return;
      }

      document.getElementById('checkout-card').style.display = 'none';
      document.getElementById('success-card').style.display = 'block';
      document.getElementById('success-message').textContent =
        `Pedido #${data.order_id} confirmado. Total: ${fmt(data.total_amount)}. Acompanhe pelo seu WhatsApp.`;
      cart.clear();
      renderCart();
    } catch (err) {
      errorEl.textContent = 'Erro de conexão. Tente novamente.';
    }
  });

  renderMenu();
  renderCart();
</script>
</body>
</html>
