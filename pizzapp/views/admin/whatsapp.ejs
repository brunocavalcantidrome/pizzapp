<%- include('../partials/head', { title: restaurant.name + ' - WhatsApp' }) %>

<header class="topbar">
  <h1>WhatsApp · <%= restaurant.name %></h1>
  <a href="/<%= restaurant.slug %>/admin">← Voltar aos pedidos</a>
</header>

<main>
  <div class="card" style="max-width: 560px;">
    <h2>Conexão</h2>
    <p>Os pedidos novos são enviados para o número abaixo via WhatsApp:</p>
    <p><strong><%= restaurant.whatsapp || '⚠️ Nenhum número cadastrado (cadastre no /sistema/admin)' %></strong></p>
    <p id="wa-status" class="empty">Verificando status...</p>
    <div id="wa-qr-wrap" style="display:none; margin-top:16px;">
      <p>Escaneie com o WhatsApp do <strong>celular da loja</strong> (Aparelhos conectados):</p>
      <div id="wa-qr"></div>
      <p><small>QR atualiza automaticamente. Após conectar, esta página mostra "Conectado".</small></p>
    </div>
    <p id="wa-ok" style="display:none;" class="msg-success">✅ WhatsApp conectado e pronto para enviar pedidos.</p>
  </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
  const SLUG = '<%= restaurant.slug %>';

  async function refreshStatus() {
    try {
      const res = await fetch(`/api/whatsapp/${SLUG}/status`);
      const s = await res.json();
      const el = document.getElementById('wa-status');
      const ok = document.getElementById('wa-ok');
      const qrWrap = document.getElementById('wa-qr-wrap');

      if (s.connected) {
        el.textContent = `Conectado${s.number ? ' (+' + s.number + ')' : ''}`;
        ok.style.display = 'block';
        qrWrap.style.display = 'none';
      } else if (s.hasQR) {
        el.textContent = 'Aguardando leitura do QR Code...';
        ok.style.display = 'none';
        qrWrap.style.display = 'block';
        await refreshQR();
      } else {
        el.textContent = 'Inicializando WhatsApp... aguarde alguns segundos.';
        ok.style.display = 'none';
      }
    } catch (e) {
      document.getElementById('wa-status').textContent = 'Erro ao consultar status.';
    }
  }

  async function refreshQR() {
    try {
      const res = await fetch(`/api/whatsapp/${SLUG}/qr`);
      if (!res.ok) return;
      const { qr } = await res.json();
      const box = document.getElementById('wa-qr');
      box.innerHTML = '';
      new QRCode(box, { text: qr, width: 256, height: 256 });
    } catch (e) { /* mantém QR anterior */ }
  }

  const socket = io();
  socket.on('whatsapp-qr', () => refreshStatus());
  socket.on('whatsapp-ready', () => refreshStatus());
  socket.on('whatsapp-disconnected', () => refreshStatus());

  refreshStatus();
  setInterval(refreshStatus, 5000);
</script>
</body>
</html>
