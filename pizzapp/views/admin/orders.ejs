<%- include('../partials/head', { title: restaurant.name + ' - Painel de Pedidos' }) %>

<header class="topbar">
  <h1>Painel · <%= restaurant.name %></h1>
  <a href="/<%= restaurant.slug %>" target="_blank">Ver cardápio ↗</a>
</header>

<main>
  <div class="toolbar">
    <nav>
      <a href="/<%= restaurant.slug %>/admin">Pedidos</a>
      <a href="/<%= restaurant.slug %>/admin/produtos">Produtos</a>
    </nav>
    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
      <button type="button" class="secondary small" id="sound-toggle" onclick="toggleSound()">🔔 Ativar som</button>
      <select id="sound-choice" onchange="onSoundChoiceChange()">
        <option value="sino-duplo">Sino duplo</option>
        <option value="ding-dong">Ding-Dong clássico</option>
        <option value="sininho-loja">Sininho de loja</option>
        <option value="alerta">Alerta de notificação</option>
        <option value="recepcao">Sino de recepção</option>
        <option value="tijolao">Tijolão (Motorola)</option>
        <option value="pizzatime">PizzaTime</option>
      </select>
      <button type="button" class="secondary small" onclick="testSelectedSound()">▶ Testar</button>
      <span id="connection-dot" title="Conexão em tempo real">●</span>
      <select id="status-filter" onchange="applyFilter()">
        <option value="">Todos os status</option>
        <option value="pending">Pendente</option>
        <option value="preparing">Preparando</option>
        <option value="shipped">Saiu para entrega</option>
        <option value="delivered">Entregue</option>
        <option value="cancelled">Cancelado</option>
      </select>
    </div>
  </div>

  <div class="card">
    <table id="orders-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Cliente</th>
          <th>Itens</th>
          <th>Total</th>
          <th>Status</th>
          <th>Criado em</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="orders-body">
        <tr><td colspan="7" class="empty">Carregando...</td></tr>
      </tbody>
    </table>
  </div>
</main>

<div class="toast" id="toast"></div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const SLUG = '<%= restaurant.slug %>';
  const INITIAL_SOUND_CHOICE = '<%= restaurant.notification_sound %>';
  const STATUSES = ['pending', 'preparing', 'shipped', 'delivered', 'cancelled'];
  const STATUS_LABELS = {
    pending: 'Pendente',
    preparing: 'Preparando',
    shipped: 'Saiu para entrega',
    delivered: 'Entregue',
    cancelled: 'Cancelado'
  };

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 1800);
  }

  function fmt(v) { return 'R$ ' + Number(v).toFixed(2); }

  async function loadOrders() {
    const status = document.getElementById('status-filter').value;
    const url = `/api/orders/${SLUG}` + (status ? `?status=${status}` : '');
    const res = await fetch(url);
    const data = await res.json();
    const body = document.getElementById('orders-body');
    body.innerHTML = '';

    if (!data.orders || data.orders.length === 0) {
      body.innerHTML = '<tr><td colspan="7" class="empty">Nenhum pedido encontrado.</td></tr>';
      return;
    }

    data.orders.forEach(order => {
      const itemsText = order.items.map(i => `${i.quantity}x ${i.product_name}`).join(', ');
      const options = STATUSES.map(s =>
        `<option value="${s}" ${s === order.status ? 'selected' : ''}>${STATUS_LABELS[s]}</option>`
      ).join('');

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>#${order.id}</td>
        <td>${order.customer_name}<br><small>${order.customer_phone}</small><br><small>${order.delivery_address}</small></td>
        <td>${itemsText}</td>
        <td>${fmt(order.total_amount)}<br><small>${order.payment_method}</small></td>
        <td><span class="badge ${order.status}">${STATUS_LABELS[order.status] || order.status}</span></td>
        <td>${new Date(order.created_at).toLocaleString('pt-BR')}</td>
        <td>
          <select onchange="updateStatus(${order.id}, this.value)">${options}</select>
        </td>
      `;
      body.appendChild(tr);
    });
  }

  async function updateStatus(orderId, status) {
    try {
      const res = await fetch(`/api/orders/${SLUG}/${orderId}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (!res.ok) {
        showToast(data.error || 'Erro ao atualizar status');
        return;
      }
      showToast(`Pedido #${orderId} atualizado`);
      loadOrders();
    } catch (err) {
      showToast('Erro de conexão');
    }
  }

  function applyFilter() { loadOrders(); }

  // --- Som de novo pedido (Web Audio API, sem depender de arquivo de audio) ---
  let audioCtx = null;
  let soundEnabled = localStorage.getItem('pizzapp_sound_enabled') === 'true';
  let currentSoundChoice = INITIAL_SOUND_CHOICE || 'sino-duplo';

  function ensureAudioCtx() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function updateSoundButton() {
    document.getElementById('sound-toggle').textContent = soundEnabled ? '🔔 Som ativado' : '🔕 Ativar som';
  }

  function toggleSound() {
    soundEnabled = !soundEnabled;
    localStorage.setItem('pizzapp_sound_enabled', soundEnabled);
    if (soundEnabled) ensureAudioCtx();
    updateSoundButton();
  }

  function tone(c, freq, start, duration, peakGain, type = 'sine') {
    const osc = c.createOscillator();
    const gain = c.createGain();
    osc.type = type;
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(0.0001, start);
    gain.gain.exponentialRampToValueAtTime(peakGain, start + Math.min(0.03, duration * 0.2));
    gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);
    osc.connect(gain).connect(c.destination);
    osc.start(start);
    osc.stop(start + duration);
  }

  function playSinoDuplo(c) {
    const now = c.currentTime;
    [880, 1175].forEach((freq, i) => tone(c, freq, now + i * 0.28, 0.6, 0.8));
  }

  function playDingDong(c) {
    const now = c.currentTime;
    tone(c, 784, now, 0.9, 0.9);
    tone(c, 587, now + 0.55, 1.1, 0.9);
  }

  function playSininhoLoja(c) {
    const now = c.currentTime;
    [1568, 1976, 1568].forEach((freq, i) => tone(c, freq, now + i * 0.15, 0.25, 0.7));
  }

  function playAlerta(c) {
    const now = c.currentTime;
    [1046, 1046, 1046].forEach((freq, i) => tone(c, freq, now + i * 0.2, 0.12, 0.9, 'square'));
  }

  function playRecepcao(c) {
    const now = c.currentTime;
    const fundamental = 1318.5; // E6
    [1, 2.01, 3.02, 4.05].forEach((mult, i) => tone(c, fundamental * mult, now, 2.2 - i * 0.3, 0.9 / (i + 1)));
  }

  function playTijolao(c) {
    const now = c.currentTime;
    function burst(startTime) {
      const freqs = [1400, 1050];
      const stepDur = 0.045;
      const totalSteps = 18;
      for (let i = 0; i < totalSteps; i++) {
        tone(c, freqs[i % 2], startTime + i * stepDur, stepDur * 0.95, 0.85, 'square');
      }
    }
    burst(now);
    burst(now + 1.1);
  }

  function playPizzaTime(c) {
    const startTime = c.currentTime;
    const freqA = 4200;
    const freqB = freqA / 2;
    const beepDuration = 0.04;
    let totalBeepsPerBurst = 8;
    const burstDuration = totalBeepsPerBurst * beepDuration;
    const pauseBetweenBursts = 0.3;

    for (let burst = 0; burst < 3; burst++) {
      const burstStartTime = startTime + burst * (burstDuration + pauseBetweenBursts);
      if (burst === 2) totalBeepsPerBurst = 20;

      for (let i = 0; i < totalBeepsPerBurst; i++) {
        const osc = c.createOscillator();
        const gainNode = c.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(i % 2 === 0 ? freqA : freqB, burstStartTime);

        const noteStart = burstStartTime + (i * beepDuration);
        const noteEnd = noteStart + beepDuration;

        gainNode.gain.setValueAtTime(0, startTime);
        gainNode.gain.setValueAtTime(0.6, noteStart);
        gainNode.gain.setValueAtTime(0, noteEnd - 0.005);

        osc.connect(gainNode);
        gainNode.connect(c.destination);
        osc.start(noteStart);
        osc.stop(noteEnd);
      }
    }
  }

  const SOUND_PLAYERS = {
    'sino-duplo': playSinoDuplo,
    'ding-dong': playDingDong,
    'sininho-loja': playSininhoLoja,
    'alerta': playAlerta,
    'recepcao': playRecepcao,
    'tijolao': playTijolao,
    'pizzatime': playPizzaTime
  };

  function playNewOrderSound() {
    if (!soundEnabled) return;
    const c = ensureAudioCtx();
    (SOUND_PLAYERS[currentSoundChoice] || playSinoDuplo)(c);
  }

  function testSelectedSound() {
    const c = ensureAudioCtx();
    (SOUND_PLAYERS[currentSoundChoice] || playSinoDuplo)(c);
  }

  async function onSoundChoiceChange() {
    currentSoundChoice = document.getElementById('sound-choice').value;
    testSelectedSound();

    try {
      const res = await fetch(`/api/settings/${SLUG}/notification-sound`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ notification_sound: currentSoundChoice })
      });
      const data = await res.json();
      if (!res.ok) {
        showToast(data.error || 'Erro ao salvar preferência de som');
        return;
      }
      showToast('Som de notificação salvo');
    } catch (err) {
      showToast('Erro de conexão ao salvar som');
    }
  }

  document.getElementById('sound-choice').value = currentSoundChoice;
  updateSoundButton();

  // --- Tempo real via Socket.IO ---
  const socket = io();
  const connectionDot = document.getElementById('connection-dot');

  socket.on('connect', () => {
    socket.emit('join', SLUG);
    connectionDot.style.color = 'var(--success)';
  });

  socket.on('disconnect', () => {
    connectionDot.style.color = 'var(--danger)';
  });

  socket.on('new-order', (data) => {
    playNewOrderSound();
    showToast(`Novo pedido recebido! #${data.order_id} - ${data.customer_name}`);
    loadOrders();
  });

  socket.on('order-updated', () => {
    loadOrders();
  });

  loadOrders();
  setInterval(loadOrders, 30000);
</script>
</body>
</html>
